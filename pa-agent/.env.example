# ─────────────────────────────────────────────────────────────────────────────
# pa-agent configuration.  Copy to `.env` and fill in.  `.env` is git-ignored.
# NEVER commit real secrets or PHI.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=3100

# --- Safety switches (default to the SAFE setting) ---
# When false, the Playwright driver fills the whole PA and STOPS at the final
# Submit button, waiting for you to confirm in the UI. Set to true only once you
# trust the calibration and want unattended submission.
AUTO_SUBMIT=false
# When true, the driver never actually submits — it fills + screenshots only.
# Great for testing selectors. Overrides AUTO_SUBMIT.
DRY_RUN=true
# Show the browser window (recommended for a single practice). false = headless.
HEADFUL=true

# --- CoverMyMeds provider portal ---
# Your own provider login. Leave BLANK to log in by hand each session
# (the driver will pause for you). Storing them enables unattended login.
CMM_USERNAME=
CMM_PASSWORD=
CMM_LOGIN_URL=https://www.covermymeds.com/login/

# --- Twilio (for texting patients for missing pharmacy / DOB info) ---
# Sign a Twilio BAA before sending any PHI over SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL Twilio will POST inbound replies to (e.g. an ngrok/https tunnel):
#   <PUBLIC_BASE_URL>/webhooks/twilio/inbound
PUBLIC_BASE_URL=

# --- Optional: Anthropic API to sharpen the medical-necessity narrative ---
# Sign an Anthropic BAA / enable zero-retention before sending PHI.
# Leave blank to use the deterministic template engine only.
ANTHROPIC_API_KEY=

# --- Ephemeral PHI ---
# Minutes a case (with PHI) is held in memory before automatic purge.
CASE_TTL_MINUTES=120
